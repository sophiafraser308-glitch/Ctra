# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# ---- Database ----
# PostgreSQL (production):  postgresql://user:pass@host:5432/dbname   (auto-converted to asyncpg)
# SQLite (Termux/dev only): sqlite+aiosqlite:///./.runtime/app.db
DATABASE_URL=sqlite+aiosqlite:///./.runtime/app.db

# ---- Security ----
# Generate with: python scripts/generate_key.py
ENCRYPTION_KEY=

# ---- cTrader Open API ----
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://your-domain.com/auth/ctrader/callback
CTRADER_ENVIRONMENT=demo
CTRADER_SCOPE=trading

# ---- Live trading hard gate (default OFF) ----
LIVE_TRADING_ENABLED=false

# ---- Web server (OAuth callback + /healthz). Railway injects PORT. ----
WEB_HOST=0.0.0.0
PORT=8080

# ---- Strategy sandbox ----
STRATEGIES_DIR=strategies
STRATEGY_SANDBOX_MODE=process
STRATEGY_DOCKER_IMAGE=ctrader-tg-platform:latest
STRATEGY_MAX_FILE_BYTES=200000
STRATEGY_ALLOWED_IMPORTS=math,statistics,collections,dataclasses,datetime,decimal,typing,enum,functools,itertools,fractions,heapq,bisect,random,json,numbers,operator
STRATEGY_ALLOWED_DEPENDENCIES=
STRATEGY_CALL_TIMEOUT_SECONDS=5
STRATEGY_MEMORY_MB=256
STRATEGY_CPU_SECONDS=86400
STRATEGY_MAX_DEPENDENCIES=5

# ---- Operations ----
MARKET_DATA_STALE_SECONDS=30
RECONCILE_INTERVAL_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=15
WATCHDOG_INTERVAL_SECONDS=20
NOTIFICATION_THROTTLE_SECONDS=300
